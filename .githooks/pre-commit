#!/bin/sh
# Pre-commit hook: block commits that contain secrets.
# Runs Gitleaks against staged changes before the commit is created.
# If Gitleaks is not installed, it warns and lets the commit proceed.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: Gitleaks is not installed. Secret scanning is mandatory in this repo."
  echo "Install it and try again:"
  echo "  Windows: winget install Gitleaks.Gitleaks"
  echo "  macOS:   brew install gitleaks"
  echo "  Linux:   curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.18.4/gitleaks_8.18.4_linux_x64.tar.gz | tar -xz -C /usr/local/bin"
  echo "Do NOT bypass this with --no-verify."
  exit 1
fi

echo "Running Gitleaks secret scan on staged changes..."
gitleaks protect --staged --verbose

if [ $? -ne 0 ]; then
  echo "ERROR: Potential secret(s) detected. Fix them or use 'git commit --no-verify' only if you are sure."
  exit 1
fi

exit 0
